    {
      "name": "meetings",
      "description": "Protected meeting endpoints (`api.auth`). Use `Authorization: Bearer {{token}}` from login; collection-level variables: `baseUrl`, `token`, `meetingId`.",
      "item": [
        {
          "name": "upload audio chunk",
          "description": "Realtime audio chunk upload used for live transcription and streaming speech processing. **Body:** `meeting_id`, `chunk_index`, file field **`audio`** (optional; queued either way). Returns **202** with `status: queued`.",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "meeting_id",
                  "value": "{{meetingId}}",
                  "type": "text",
                  "description": "Meeting ID (integer)"
                },
                {
                  "key": "chunk_index",
                  "value": "5",
                  "type": "text",
                  "description": "Zero-based chunk sequence"
                },
                {
                  "key": "audio",
                  "type": "file",
                  "src": "",
                  "description": "Audio file (e.g. wav/webm); max 51200 KB per validation"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/audio/chunk",
              "host": ["{{baseUrl}}"],
              "path": ["api", "audio", "chunk"],
              "query": [],
              "variable": []
