        {
          "name": "upload intro chunk",
          "description": "Intro enrollment audio chunks for speaker recognition and voice embedding generation. **Required:** `chunk_index`, **`audio`** (file). Optional: `duration_seconds`. Query **`sync=1`** runs inline (no queue worker). Async returns **202** `status: queued`; sync success returns enrolled participants.",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "chunk_index",
                  "value": "0",
                  "type": "text",
                  "description": "Zero-based intro chunk index"
                },
                {
                  "key": "audio",
                  "type": "file",
                  "src": "",
                  "description": "Intro audio file"
                },
                {
                  "key": "duration_seconds",
                  "value": "4.5",
                  "type": "text",
                  "description": "Optional; 1–60",
                  "disabled": true
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/meetings/{{meetingId}}/intro/chunk",
