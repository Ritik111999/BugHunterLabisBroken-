# Example nginx fragment: TLS + WebSocket proxy for WeChirp live relay.
# Relay process: php artisan deepgram:relay --host=127.0.0.1 --port=9001
# APP .env: WC_RELAY_WS_URL=wss://api.example.com/ws-relay

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

upstream wechirp_relay {
    # Sticky sessions required when running multiple relay workers (in-memory meeting state).
    ip_hash;
    server 127.0.0.1:9001;
    # server 127.0.0.1:9011;
}

server {
    listen 443 ssl http2;
    server_name api.example.com;

    # ssl_certificate ...
    # ssl_certificate_key ...

    location / {
        proxy_pass http://127.0.0.1:9000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /ws-relay/ {
        proxy_pass http://wechirp_relay/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }
}
