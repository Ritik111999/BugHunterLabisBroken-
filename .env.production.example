# =============================================================================
# WeChirp — production environment template
# Copy to .env on your server and fill in secrets. See docs/wechirp-production.md
# =============================================================================

APP_NAME=WeChirp
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.yourdomain.com

# Sanctum / Capacitor: must match your public API origin
SESSION_DRIVER=database
SESSION_DOMAIN=.yourdomain.com
SANCTUM_STATEFUL_DOMAINS=api.yourdomain.com

LOG_CHANNEL=stack
LOG_LEVEL=warning

# --- Database (PostgreSQL recommended) ---
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=wechirp
DB_USERNAME=wechirp
DB_PASSWORD=

# --- Redis (queues + cache) ---
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_RETRY_AFTER=3600

WECHIRP_QUEUE_AUDIO=audio
WECHIRP_QUEUE_DEFAULT=default

# --- Meeting audio chunks (S3) ---
WECHIRP_AUDIO_DISK=s3
WECHIRP_AUDIO_PREFIX=meeting_chunks
FILESYSTEM_DISK=local

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=wechirp-audio-prod
# AWS_URL=
# AWS_ENDPOINT=          # MinIO / R2: set endpoint + AWS_USE_PATH_STYLE_ENDPOINT=true
# AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Deepgram (required) ---
DEEPGRAM_API_KEY=
MEETING_STT_PROVIDER=deepgram
DEEPGRAM_LIVE_MODEL=nova-3
MEETING_DEEPGRAM_PRERECORD_MODEL=nova-2
MEETING_DEEPGRAM_LANGUAGE=en
DEEPGRAM_LIVE_ENDPOINTING_MS=120

# --- OpenAI (summaries + search) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Live WebSocket relay (TLS) ---
WC_RELAY_HOST=127.0.0.1
WC_RELAY_PORT=9001
WC_RELAY_WS_URL=wss://api.yourdomain.com/ws-relay

# Capacitor loads the SPA from your API
# CAPACITOR_SERVER_URL=https://api.yourdomain.com/app

# --- Voiceprint Python (run setup-voiceprint on the server) ---
MEETING_ANALYZER_TIMEOUT=120
MEETING_INTRO_ANALYZER_VOICEPRINT=1

# --- Mail (optional) ---
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@yourdomain.com
MAIL_FROM_NAME="${APP_NAME}"

# --- IAP (set IAP_TRUST_CLIENT=false when server verification is live) ---
IAP_TRUST_CLIENT=false
IAP_VERIFY_IOS_RECEIPT=true
APPLE_SHARED_SECRET=
