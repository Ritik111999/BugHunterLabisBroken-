# WeChirp / Meet — local development (PHP + Node on your machine; no Docker in this repo)
APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Use 127.0.0.1 with Capacitor server.url so cookies / Sanctum match the WebView origin.
# Default dev stack: HTTP 9000, relay WS 9001, Vite 9002 (`composer dev`).
APP_URL=http://127.0.0.1:9000

# Optional: authenticated /api throttle (requests per minute per user, clamped 300–2500 in AppServiceProvider).
# API_AUTH_REQUESTS_PER_MINUTE=900

# Optional: full WebView URL for Capacitor live reload (defaults to APP_URL + "/app").
# CAPACITOR_SERVER_URL=http://127.0.0.1:9000/app

# Optional: substring appended to Capacitor WebView user agent (must match mobile/capacitor.config.json
# ios.appendUserAgent / android.appendUserAgent, default WeChirpCapacitorShell). Required so /app skips Vite "hot".
# WECHIRP_NATIVE_UA_TOKEN=WeChirpCapacitorShell

# Studio /app: show relay URL, chunk settings, voice-tuning + live-log debug panels during recording.
# WECHIRP_SHOW_DEV_TOOLS=true
# WECHIRP_STUDIO_DEBUG_PANELS=true

# Meeting demo + Capacitor: WebSocket relay (php artisan deepgram:relay)
WC_RELAY_HOST=127.0.0.1
WC_RELAY_PORT=9001
# Optional: full relay URL (defaults to ws://WC_RELAY_HOST:WC_RELAY_PORT locally;
# on https APP_URL defaults to wss://APP_HOST:WC_RELAY_PORT for physical devices)
# WC_RELAY_WS_URL=ws://127.0.0.1:9001
# Production example: WC_RELAY_WS_URL=wss://api.yourdomain.com/ws-relay

# Live relay tuning (php artisan deepgram:relay)
# MEETING_RELAY_TOKEN_TTL_SECONDS=900
# MEETING_RELAY_MAX_CONNECTIONS=100
# MEETING_RELAY_MAX_FRAME_BYTES=65536
# MEETING_WS_PERSIST_INTERVAL_SECONDS=8
# MEETING_RELAY_UPSTREAM_KEEPALIVE_SECONDS=4
# MEETING_RELAY_REDIS_HOT_STATE=true
# MEETING_RELAY_REDIS_TTL_SECONDS=7200
# MEETING_RELAY_STICKY_SESSIONS=true
# MEETING_RELAY_POST_AUTH_TIMEOUT_SECONDS=5
# MEETING_RELAY_PCM_BUFFER_SECONDS=5
# Multi-relay cluster (optional): npm run relay:cluster → ws://127.0.0.1:9100
# RELAY_CLUSTER_PORTS=9001,9011,9021
# RELAY_CLUSTER_PORT=9100
# WC_RELAY_WS_URL=ws://127.0.0.1:9100

# Node Deepgram gateway (STT in Node; Laravel handles DB + voiceprints)
# WECHIRP_RELAY_ENGINE=node
# WC_RELAY_GATEWAY_HOST=127.0.0.1
# WC_RELAY_GATEWAY_PORT=9200
# RELAY_INTERNAL_SECRET=generate-a-long-random-string
# LARAVEL_URL=http://127.0.0.1:9000
# MEETING_NODE_VOICE_CHUNK_SECONDS=2.5
# Dev with Node gateway: composer run dev:node  (or npm run relay:gateway + composer dev without php relay)

# WeChirp stack: Deepgram STT + OpenAI intelligence (see docs/wechirp-stack.md)
# Post-meeting summary, topics, decisions, action items + semantic search
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# WECHIRP_AI_MAX_TRANSCRIPT_CHARS=14000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Intro + meeting chunk jobs use the "audio" queue. Use `composer run dev` or `php artisan queue:listen --queue=audio,default`.

CACHE_STORE=database
# CACHE_PREFIX=

# Meeting audio diarization provider (used by scripts/analyze_audio.py)
DEEPGRAM_API_KEY=

# Optional: LLM meeting summary after end (SummarizeMeetingJob). Admin settings ai.openai_* also work.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# STT: deepgram only (WeChirp product standard; other providers are deprecated)
MEETING_STT_PROVIDER=deepgram
# Batch / intro prerecorded Deepgram model (e.g. nova-2, nova-2-general). Passed to analyze_audio.py.
MEETING_DEEPGRAM_PRERECORD_MODEL=nova-2
# Intro enrollment uses single-speaker STT with this language hint (empty = omit; default en).
MEETING_DEEPGRAM_LANGUAGE=en
# FFmpeg + embed tuning: default | bluetooth | wired (aliases: bt, wireless, usb, …). Client can override per intro upload.
MEETING_AUDIO_INPUT_PROFILE=default
# Optional cap on intro analyzer subprocess timeout (seconds). 0 = use MEETING_ANALYZER_TIMEOUT only.
MEETING_INTRO_ANALYZER_TIMEOUT=0
# Optional ECAPA decode window cap for embed_audio.py when --max-seconds omitted (server-side default only).
MEETING_EMBED_MAX_SECONDS=8
# Optional override for RMS target before ECAPA (e.g. 0.1). Empty = profile-based default in embed_audio.py.
MEETING_EMBED_TARGET_RMS=
PULSE_API_KEY=
PULSE_LANGUAGE=en
# Live relay: Deepgram streaming endpointing (ms). Lower = snappier partials/finals (50–2000).
# Lower = snappier partials/finals (50–2000). Default 120 balances latency vs stability.
# Live STT tuning (lower endpointing = snappier partials; 80–150 recommended for meetings)
DEEPGRAM_LIVE_ENDPOINTING_MS=100
DEEPGRAM_LIVE_UTTERANCE_END_MS=900
DEEPGRAM_LIVE_VAD_EVENTS=true
MEETING_WS_TRANSCRIPT_PUSH_INTERVAL_SECONDS=0.03
MEETING_WS_OVERLAP_MIN_SECONDS=0.12
# Relay → browser: stats push interval (seconds). Min 0.05, max 2.0.
MEETING_WS_STATS_INTERVAL_SECONDS=0.1
# After each STT message, push stats if this many seconds elapsed (0 = off). Clamped 0.03–0.5.
MEETING_WS_STATS_IMMEDIATE_MIN_SECONDS=0
# Python for analyze_audio.py / embed_audio.py (voiceprint). Empty = auto-use scripts/.venv/bin/python if present, else python3.
# Run once: bash scripts/setup-voiceprint.sh
MEETING_ANALYZER_PYTHON=
MEETING_ANALYZER_SCRIPT=
# Intro upload: analyzer includes SpeechBrain global voiceprint by default (enrollment + live matching).
MEETING_INTRO_ANALYZER_VOICEPRINT=1
# Legacy: 1 = force-disable analyzer voiceprint (names only; PHP may run embed_audio.py fallback).
MEETING_INTRO_SKIP_VOICEPRINT=0
# Rare: 1 = also run per-speaker ECAPA in intro (slower; use if one clip has multiple speakers).
MEETING_INTRO_PER_LABEL_VOICEPRINT=0
# Allow merging client-provided intro captions (Web Speech API) with the uploaded clip for name matching. Also enabled when APP_ENV=local.
# Merge client assistant_utterance into intro when cloud STT is empty (recommended for Simulator).
MEETING_INTRO_ALLOW_ASSISTANT_UTTERANCE=true
# Capacitor shell (WeChirpCapacitorShell in user agent): allow assistant + manual bind (default true).
# MEETING_INTRO_ALLOW_ASSISTANT_UTTERANCE_CAPACITOR=true
# MEETING_INTRO_ALLOW_MANUAL_BIND_CAPACITOR=true
# When true (or APP_ENV=local), optional bind_participant_id on intro upload can attach a clip to an existing named row if STT returns no words (simulator / dev).
MEETING_INTRO_ALLOW_MANUAL_BIND=true
# When true, skip the "near-identical voiceprints" check on meeting start (dev/simulator only; weakens attribution safety).
MEETING_START_RELAX_DUPLICATE_CHECK=false
MEETING_VOICEPRINT_THRESHOLD=0.78
MEETING_VOICEPRINT_MARGIN=0.06
MEETING_WS_SLICE_SECONDS=1
MEETING_WS_EMBED_EVERY_N=5
MEETING_WS_BOOTSTRAP_CHUNKS=8
MEETING_WS_LABEL_WINDOW_SECONDS=8
MEETING_WS_LABEL_MIN_SPEECH_SECONDS=2.5
MEETING_WS_LABEL_EMBED_COOLDOWN_SECONDS=4
MEETING_VOICEPRINT_EARLY_BOOST=0.07
MEETING_VOICEPRINT_DEBUG=false
MEETING_WS_MAX_AUDIO_KEEP_SECONDS=35
MEETING_WS_MAX_TRANSCRIPT_CHARS=6000
MEETING_WS_LABEL_MIN_PURITY=0.65
MEETING_WS_FAST_IDENTIFY=true
MEETING_WS_FAST_IDENTIFY_AFTER_SECONDS=1.5
MEETING_WS_FAST_IDENTIFY_MIN_SCORE=0.68
MEETING_WS_FAST_IDENTIFY_MIN_MARGIN=0.02
MEETING_WS_FAST_IDENTIFY_WINDOW_SECONDS=1.2
MEETING_INTRO_DUPLICATE_VOICEPRINT_SIM=0.972
MEETING_INTRO_MIN_DURATION_SECONDS=1.2
MEETING_INTRO_MIN_STT_WORDS=2
MEETING_START_DUPLICATE_VOICEPRINT_SIM=0.972
MEETING_VOICEPRINT_MARGIN=0.05

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Meeting chunk storage: meeting_audio (local) | s3 (production — see .env.production.example)
WECHIRP_AUDIO_DISK=meeting_audio
WECHIRP_AUDIO_PREFIX=meeting_chunks

# Production queues (dev default: database). Use redis + scripts/production-queue-worker.sh
# QUEUE_CONNECTION=redis
# CACHE_STORE=redis
# REDIS_QUEUE_RETRY_AFTER=3600
# WECHIRP_QUEUE_AUDIO=audio
# WECHIRP_QUEUE_DEFAULT=default

VITE_APP_NAME="${APP_NAME}"

# In-App Purchase (subscription)
IAP_PRODUCT_ID_MONTHLY=com.wechirp.premium.monthly
IAP_DEFAULT_EXPIRES_DAYS=30
# If true, backend will not verify Google Play / Apple App Store receipts/tokens.
# Set to false and add server-side verification later.
IAP_TRUST_CLIENT=true

# Secure iOS receipt verification (recommended)
IAP_VERIFY_IOS_RECEIPT=true
APPLE_SHARED_SECRET=
APPLE_VERIFY_RECEIPT_URL_PROD=https://buy.itunes.apple.com/verifyReceipt
APPLE_VERIFY_RECEIPT_URL_SANDBOX=https://sandbox.itunes.apple.com/verifyReceipt
