APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# Meeting audio diarization provider (used by scripts/analyze_audio.py)
DEEPGRAM_API_KEY=
# Live + batch STT: deepgram | pulse (Smallest AI Waves)
MEETING_STT_PROVIDER=deepgram
PULSE_API_KEY=
PULSE_LANGUAGE=en
# Live relay: Deepgram streaming endpointing (ms). Lower = snappier partials/finals (50–2000).
DEEPGRAM_LIVE_ENDPOINTING_MS=200
MEETING_ANALYZER_PYTHON=
MEETING_ANALYZER_SCRIPT=
MEETING_VOICEPRINT_THRESHOLD=0.75
MEETING_WS_SLICE_SECONDS=1
MEETING_WS_EMBED_EVERY_N=5
MEETING_WS_BOOTSTRAP_CHUNKS=8
MEETING_WS_LABEL_WINDOW_SECONDS=8
MEETING_WS_LABEL_MIN_SPEECH_SECONDS=2.5
MEETING_WS_LABEL_EMBED_COOLDOWN_SECONDS=4
MEETING_VOICEPRINT_EARLY_BOOST=0.07
MEETING_VOICEPRINT_DEBUG=false
MEETING_WS_MAX_AUDIO_KEEP_SECONDS=35
MEETING_WS_MAX_TRANSCRIPT_CHARS=6000
MEETING_WS_LABEL_MIN_PURITY=0.65
MEETING_WS_FAST_IDENTIFY=true
MEETING_WS_FAST_IDENTIFY_AFTER_SECONDS=2.0
MEETING_WS_FAST_IDENTIFY_MIN_SCORE=0.62
MEETING_WS_FAST_IDENTIFY_MIN_MARGIN=0.015
MEETING_VOICEPRINT_MARGIN=0.05

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# In-App Purchase (subscription)
IAP_PRODUCT_ID_MONTHLY=com.wechirp.premium.monthly
IAP_DEFAULT_EXPIRES_DAYS=30
# If true, backend will not verify Google Play / Apple App Store receipts/tokens.
# Set to false and add server-side verification later.
IAP_TRUST_CLIENT=true

# Secure iOS receipt verification (recommended)
IAP_VERIFY_IOS_RECEIPT=true
APPLE_SHARED_SECRET=
APPLE_VERIFY_RECEIPT_URL_PROD=https://buy.itunes.apple.com/verifyReceipt
APPLE_VERIFY_RECEIPT_URL_SANDBOX=https://sandbox.itunes.apple.com/verifyReceipt
